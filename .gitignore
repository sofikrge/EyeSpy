# Only code is tracked. Everything the pipeline reads or writes stays local.

# Pipeline input and output.
# The * suffixes also catch the one-off variant folders (*OLD, *BackUp, RIGHTINTERPOL*).
data/
*analysesresults*/
DataQualityChecks*/
Figures*/
Archive/

# Python
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info
.venv

# Scratch / temp working files
scratchpad_*
*.npz

# Editor / OS / assistant
.DS_Store
.claude/
CLAUDE.md
